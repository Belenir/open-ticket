[
  {
    "id": "anketa_panel",
    "channel": "1548418283148017837",
    "role": "EVERYONE",
    "embed": {
      "title": "✨ Подача заявки / Заполнение анкеты ✨",
      "description": "Нажмите на кнопку ниже, чтобы начать заполнение формы прямо на сервере.",
      "color": "#2ecc71"
    },
    "button": {
      "label": "Заполнить анкету",
      "style": "SUCCESS",
      "emoji": "📝"
    },
    "ticket": {
      "category": "1548416940144337067",
      "admin_channel": "1548418283148017837",
      "name_format": "анкета-{username}",
      "options": ["text_input_1", "text_input_2", "date_input", "select_menu", "image_upload"],
      "final_embed": {
        "title": "📥 Получена новая форма от {username}",
        "color": "#3498db",
        "fields": [
          { "name": "Текст 1", "value": "{answers.text_input_1}" },
          { "name": "Текст 2", "value": "{answers.text_input_2}" },
          { "name": "Дата", "value": "{answers.date_input}" },
          { "name": "Выбранный вариант", "value": "{answers.select_menu}" }
        ],
        "image": "{answers.image_upload}"
      }
    }
  }
]
